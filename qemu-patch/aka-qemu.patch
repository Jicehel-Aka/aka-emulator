+/* AKA: live view of the flash storage for the ESP32-S3 cache model */
+bool aka_m25p80_read(uint32_t addr, uint8_t *buf, size_t len);
+static Flash *aka_flash_inst;
+uint64_t aka_flash_gen;
+uint32_t aka_flash_dlo = 0xffffffffu, aka_flash_dhi;
+
+uint8_t *aka_cache_flash_ram;
+uint64_t aka_cache_flash_size;
+
+static inline void aka_flash_dirty(uint32_t lo, uint32_t len)
+{
+    if (aka_cache_flash_ram && aka_flash_inst &&
+        (uint64_t) lo + len <= aka_cache_flash_size) {
+        memcpy(aka_cache_flash_ram + lo, aka_flash_inst->storage + lo, len);
+    }
+    aka_flash_gen++;
+    if (lo < aka_flash_dlo) {
+        aka_flash_dlo = lo;
+    }
+    if (lo + len > aka_flash_dhi) {
+        aka_flash_dhi = lo + len;
+    }
+}
+
+bool aka_m25p80_read(uint32_t addr, uint8_t *buf, size_t len)
+{
+    if (!aka_flash_inst || !aka_flash_inst->storage ||
+        (uint64_t) addr + len > aka_flash_inst->size) {
+        return false;
+    }
+    memcpy(buf, aka_flash_inst->storage + addr, len);
+    return true;
+}
