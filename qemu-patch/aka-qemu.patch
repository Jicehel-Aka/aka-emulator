+/* Re-read every flash-mapped page so the cache model stays coherent with flash writes
+ * (real hardware: cache invalidate after SPI1 program/erase). */
+extern uint8_t *aka_cache_flash_ram;
+extern uint64_t aka_cache_flash_size;
+extern uint64_t aka_flash_gen;
+extern uint32_t aka_flash_dlo, aka_flash_dhi;
+bool aka_m25p80_read(uint32_t addr, uint8_t *buf, size_t len);
+
+static void aka_cache_read_flash(ESP32S3CacheState *s, uint32_t pa, uint8_t *d)
+{
+    if (!aka_m25p80_read(pa, d, ESP32S3_PAGE_SIZE)) {
+        blk_pread(s->flash_blk, pa, ESP32S3_PAGE_SIZE, d, 0);
+    }
+}
+
+static void esp32s3_cache_refresh_flash(ESP32S3CacheState *s)
+{
+    if (s->flash_blk == NULL) {
+        return;
+    }
+    static uint64_t last_gen = ~0ULL;
+    if (last_gen == aka_flash_gen) {
+        return;
+    }
+    last_gen = aka_flash_gen;
+    const uint32_t dlo = aka_flash_dlo, dhi = aka_flash_dhi;
+    aka_flash_dlo = 0xffffffffu;
+    aka_flash_dhi = 0;
+    ESP32S3XtsAesClass *xts_aes_class = ESP32S3_XTS_AES_GET_CLASS(s->xts_aes);
+    for (int i = 0; i < ESP32S3_MMU_TABLE_ENTRY_COUNT; i++) {
+        const ESP32S3MMUEntry e = s->mmu[i];
+        if (e.invalid || e.type != ESP32S3_MMU_TYPE_FLASH) {
+            continue;
+        }
+        const uint32_t pa = e.page_number * ESP32S3_PAGE_SIZE;
+        if (pa >= dhi || pa + ESP32S3_PAGE_SIZE <= dlo) {
+            continue;
+        }
+        if ((uint64_t) pa + ESP32S3_PAGE_SIZE > memory_region_size(&s->flash_mr)) {
+            continue;
+        }
+        uint8_t *d = ((uint8_t *) memory_region_get_ram_ptr(&s->flash_mr)) + pa;
+        aka_cache_read_flash(s, pa, d);
+        if (xts_aes_class->is_flash_enc_enabled(s->xts_aes)) {
+            xts_aes_class->decrypt(s->xts_aes, pa, d, ESP32S3_PAGE_SIZE);
+        }
+    }
+}
