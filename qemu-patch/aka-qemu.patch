+bool esp_gdma_find_out_channel(ESPGdmaState *s, GdmaPeripheral periph, uint32_t *chan)
+{
+    const ESPGdmaClass *class = ESP_GDMA_GET_CLASS(s);
+
+    for (uint32_t i = 0; i < class->m_channel_count; i++) {
+        if (FIELD_EX32(s->ch_conf[ESP_GDMA_OUT_IDX][i].peripheral, GDMA_PERI_SEL, PERI_SEL) == periph) {
+            *chan = i;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool esp_gdma_out_take_start(ESPGdmaState *s, uint32_t chan)
+{
+    DmaConfigState *state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+
+    if (FIELD_EX32(state->link, GDMA_OUT_LINK, START)) {
+        state->link &= R_GDMA_OUT_LINK_ADDR_MASK;           /* clear START/RESTART */
+        state->stream_desc = ((ESP_GDMA_RAM_ADDR >> 20) << 20) | FIELD_EX32(state->link, GDMA_OUT_LINK, ADDR);
+        state->stream_off = 0;
+        state->stream_active = true;
+        return true;
+    }
+    return false;
+}
+
+uint32_t esp_gdma_out_stream(ESPGdmaState *s, uint32_t chan, uint8_t *buffer, uint32_t size)
+{
+    DmaConfigState *state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+    uint32_t produced = 0;
+
+    if (!state->stream_active) {
+        return 0;
+    }
+    while (produced < size) {
+        GdmaLinkedList node;
+
+        if (!esp_gdma_read_descr(s, state->stream_desc, &node) || !node.config.owner) {
+            state->stream_active = false;       /* chain ended or descriptor error */
+            break;
+        }
+        const uint32_t avail = node.config.length - state->stream_off;
+        const uint32_t n = MIN(avail, size - produced);
+
+        if (n && !esp_gdma_read_guest(s, node.buf_addr + state->stream_off, buffer + produced, n)) {
+            esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_OUT_DSCR_ERR_MASK);
+            state->stream_active = false;
+            break;
+        }
+        produced += n;
+        state->stream_off += n;
+        if (state->stream_off >= node.config.length) {
+            if (node.config.suc_eof) {
+                state->suc_eof_desc_addr = state->stream_desc;
+                esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_OUT_EOF_MASK |
+                                                       R_GDMA_INTERRUPT_OUT_DONE_MASK);
+            }
+            esp_gdma_push_descriptor(s, chan, ESP_GDMA_OUT_IDX, node.next_addr);
+            state->stream_desc = node.next_addr;
+            state->stream_off = 0;
+            if (!node.next_addr) {
+                state->stream_active = false;   /* end of a non circular list: total EOF */
+                esp_gdma_set_status(&state->int_state, R_GDMA_INTERRUPT_OUT_TOTAL_EOF_MASK);
+                break;
+            }
+        }
+    }
+    return produced;
+}
+
 /**
  * @brief Write data to the guest RAM pointed by the linked list configured in the given DmaConfigState index.
  *        `size` bytes from `buffer` will be written to guest machine's RAM.
@@ -1021,3 +1098,26 @@ static void esp_gdma_register_types(void)
 }
 
 type_init(esp_gdma_register_types)
+
+
+uint32_t esp_gdma_out_chain_length(ESPGdmaState *s, uint32_t chan)
+{
+    DmaConfigState* state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+    uint32_t addr = ((ESP_GDMA_RAM_ADDR >> 20) << 20) |
+                    FIELD_EX32(state->link, GDMA_OUT_LINK, ADDR);
+    uint32_t total = 0;
+
+    /* Walk the transmit list until the descriptor flagged EOF (bounded) */
+    for (int node = 0; node < 8192; node++) {
+        GdmaLinkedList desc;
+        if (!esp_gdma_read_descr(s, addr, &desc)) {
+            break;
+        }
+        total += desc.config.length;
+        if (desc.config.suc_eof || desc.next_addr == 0) {
+            break;
+        }
+        addr = desc.next_addr;
+    }
+    return total;
+}
